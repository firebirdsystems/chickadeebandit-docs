{
  "id": "docs",
  "name": "Documents",
  "version": "1.1.0",
  "description": "Store and share documents — receipts, medical records, school papers, insurance policies. Organise into folders with adult-only or organization-wide visibility.",
  "entrypoint": "index.html",
  "runtime": "static",
  "storage": "none",
  "category": "general",
  "tags": [
    "documents",
    "files",
    "storage",
    "pdf",
    "photos"
  ],
  "publishes": [],
  "data_access": {
    "reads": [
      "family.members",
      "family.groups",
      "family.documents"
    ],
    "writes": [
      "family.documents"
    ]
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "contexts": [
    "household",
    "shared_space.roster"
  ],
  "document_acls": {
    "write": {
      "roster_steward_only": true
    }
  },
  "file_acls": {
    "write": {
      "roster_steward_only": true
    }
  },
  "nav": {
    "label": "Documents"
  },
  "cdn_whitelist": [
    "https://unpkg.com"
  ],
  "resource_limits": {
    "max_file_bytes": 10485760,
    "max_files_bytes": 524288000,
    "max_docs_bytes": 524288000
  },
  "icon": "📄"
}
