{
  "id": "docs",
  "name": "Documents",
  "version": "1.2.0",
  "description": "Store and share documents \u2014 receipts, medical records, school papers, insurance policies. Organise into folders with adult-only or organization-wide visibility.",
  "entrypoint": "index.html",
  "runtime": "static",
  "storage": "none",
  "category": "general",
  "tags": [
    "documents",
    "files",
    "storage",
    "pdf",
    "photos"
  ],
  "publishes": [],
  "data_access": {
    "reads": [
      "family.members",
      "family.groups",
      "family.documents"
    ],
    "writes": [
      "family.documents"
    ]
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "contexts": [
    "household",
    "shared_space",
    "shared_space.roster"
  ],
  "document_acls": {
    "write": {
      "require_role": "adult",
      "roster_steward_only": true
    }
  },
  "file_acls": {
    "write": {
      "require_role": "adult",
      "roster_steward_only": true
    },
    "read": "document_acl"
  },
  "store_acls": {
    "folders_meta": {
      "write": {
        "require_role": "adult",
        "roster_steward_only": true
      }
    },
    "folders_private": {
      "read": {
        "require_role": "adult"
      },
      "write": {
        "require_role": "adult",
        "roster_steward_only": true
      }
    }
  },
  "nav": {
    "label": "Documents"
  },
  "cdn_whitelist": [
    "https://unpkg.com"
  ],
  "resource_limits": {
    "max_file_bytes": 10485760,
    "max_files_bytes": 524288000,
    "max_docs_bytes": 524288000
  },
  "icon": "\ud83d\udcc4"
}
